# Neuralake Configuration

# Database
NEURALAKE_DATABASE__URL=postgresql+asyncpg://neuralake:neuralake@localhost:5432/neuralake

# Redis
NEURALAKE_REDIS__URL=redis://localhost:6379/0

# LLM Provider (anthropic, gemini, openai, local)
NEURALAKE_LLM__PROVIDER=anthropic
NEURALAKE_LLM__ANTHROPIC_API_KEY=your-anthropic-api-key
NEURALAKE_LLM__MODEL=claude-sonnet-4-20250514
NEURALAKE_LLM__EXTRACTION_MODEL=claude-haiku-4-5-20251001
# NEURALAKE_LLM__GEMINI_API_KEY=your-gemini-api-key
# NEURALAKE_LLM__OPENAI_API_KEY=your-openai-api-key

# Embedding Provider (gemini, openai, cohere, local)
NEURALAKE_EMBEDDING__PROVIDER=gemini
NEURALAKE_EMBEDDING__GEMINI_API_KEY=your-gemini-api-key
NEURALAKE_EMBEDDING__MODEL=gemini-embedding-001
# NEURALAKE_EMBEDDING__OPENAI_API_KEY=your-openai-api-key

# Auth
NEURALAKE_AUTH__JWT_SECRET=change-me-to-a-random-string

# Application
NEURALAKE_ENVIRONMENT=development
NEURALAKE_DEBUG=true
NEURALAKE_LOG_LEVEL=INFO
